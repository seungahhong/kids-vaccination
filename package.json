{
  "name": "kids-vaccination",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.3 <25"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "lucide-react-native": "1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "typegen": "expo customize tsconfig.json",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=Asia/Seoul jest",
    "test:tz:seoul": "TZ=Asia/Seoul jest",
    "test:tz:ny": "TZ=America/New_York jest",
    "test:ci": "npm run test:tz:seoul -- --coverage && npm run test:tz:ny",
    "e2e": "CI=1 playwright test",
    "export:web": "expo export --platform web",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:ci && npm run export:web"
  },
  "private": true
}
